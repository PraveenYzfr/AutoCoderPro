# Copy to .env and fill in. Never commit real secrets.

# Trigger / webhook switches
AUTOCODER_TRIGGERS_MODE=both
AUTOCODER_WEBHOOKS_ENABLED=true
AUTOCODER_WEBHOOKS_DRY_RUN=true
AUTOCODER_WEBHOOKS_PORT=8081
AUTOCODER_CONFIG=config/autocoder.yml

# Jira — public site root (no ticket key here; pass --ticket at runtime)
# Example: https://acme.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_WEBHOOK_SECRET=

# GitHub — YOU choose which repo AutoCoder may change
# Example: https://github.com/acme/my-service
GITHUB_REPO_URL=
GITHUB_TOKEN=

# Auth mode: pat (local/dev) | github_app (enterprise bot)
GITHUB_AUTH_MODE=pat
# For github_app:
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/app.pem
# GITHUB_APP_PRIVATE_KEY=

# Live PR runs: set true to skip the plan approval prompt
AUTOCODER_AUTO_APPROVE=false

# LLM — DeepSeek is cheap/primary (coding + summarize).
# Anthropic Claude or OpenAI is costly (planning / thinking).
# Do NOT set AUTOCODER_LLM_PROVIDER=deepseek; that used to send planning to DeepSeek too.
# AUTOCODER_CHEAP_PROVIDER=groq         # latency: Groq Llama instead of DeepSeek for coding/summarize
# AUTOCODER_COSTLY_PROVIDER=anthropic   # or openai
# AUTOCODER_CODING_TIER=cheap           # set costly only if you want GPT/Gemini to write code
# AUTOCODER_LLM_FORCE_SINGLE=false
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT_NUMBER=
# App-side hard cap (vendor budgets only alert). 0 = unlimited. DeepSeek can tolerate more than Gemini free-tier.
AUTOCODER_LLM_DAILY_CALL_BUDGET=0
DEEPSEEK_API_KEY=
GROQ_API_KEY=
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
